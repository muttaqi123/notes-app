# Server
PORT=4000
NODE_ENV=development

# Database — a local mongod, or an Atlas SRV string in production.
# Leave MONGODB_URI empty in development and the server boots an in-memory
# MongoDB automatically, so the app runs with no database installed.
MONGODB_URI=mongodb://127.0.0.1:27017/keep-notes

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-in-production-access
JWT_REFRESH_SECRET=change-me-in-production-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173
